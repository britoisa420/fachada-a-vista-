# Porta e pasta de dados (banco SQLite + arquivos privados). Use um disco persistente em produção.
PORT=3000
DATA_DIR=./data
# Endereço público usado nos links enviados aos clientes e no retorno do checkout
PUBLIC_URL=https://simulador.delta.com.br

# Primeiro acesso da equipe ao painel (sem isso, usa equipe@delta.local / delta-demo-2026)
ADMIN_EMAIL=equipe@delta.com.br
ADMIN_PASSWORD=troque-esta-senha

# Pagamento: demo | link | mercadopago (se definido, trava a escolha feita no painel)
PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=
MP_SANDBOX=0
